# Code Your Reality — backend configuration.
# Copy to .env (repository root or backend/) and fill in. Never commit .env.
# Everything here stays on the server: the browser never receives these values.
# Each setting also accepts an RC_-prefixed name (e.g. RC_OLLAMA_MODEL), which takes precedence.

# --- AI model (Ollama) -----------------------------------------------------------------------------
# Local Ollama (default, the Windows/dev setup):
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e4b
# Ollama Cloud (VPS without a GPU): uncomment and set your key from https://ollama.com/settings/keys
# OLLAMA_URL=https://ollama.com
# OLLAMA_API_KEY=
# OLLAMA_MODEL=gemma4:31b
# Send video frames to the model: auto = ask the server (/api/show); set true for a vision model on
# Ollama Cloud, where capabilities may not be reported. false = transcript and narration only.
OLLAMA_VISION=auto
# Structured outputs (the JSON schema sent in "format"): auto = on for local Ollama, off for Ollama
# Cloud, which doesn't support them. When off, the schema goes into the prompt and each answer is
# validated on the server, with at most 2 repair requests that say exactly what didn't fit.
OLLAMA_STRUCTURED_OUTPUTS=auto
OLLAMA_TIMEOUT_SECONDS=600

# --- Speech to text (faster-whisper) ---------------------------------------------------------------
WHISPER_ENABLED=true
# Model size: tiny | base | small | medium | large-v3 (larger = slower, more accurate)
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# --- Server ----------------------------------------------------------------------------------------
# Data directory: database, uploads, frames. Docker sets /data.
# DATA_DIR=./backend/data
# Serve the built frontend from the backend (the Docker image sets this). Set it empty for an API-only
# server; frontends on any other origin call it with a bearer token (CORS allows every origin).
# FRONTEND_DIST=./frontend/dist
# Studio sign-in: the first account registered on /login becomes admin and adds the others under
# Account -> Users. Set ALLOW_SIGNUP=true to let anyone create an account themselves.
ALLOW_SIGNUP=false
# HTTPS served by the app itself on 7413: PEM certificate (full chain) and private key, readable by
# uid 1000 in the container. Leave unset for plain HTTP behind a TLS proxy (DSM reverse proxy, Caddy).
# TLS_CERT_FILE=/tls/fullchain.pem
# TLS_KEY_FILE=/tls/privkey.pem
# Mark the session cookie Secure (set true behind an HTTPS reverse proxy such as Caddy). The cookie is only
# used when the frontend is served by this backend; separate frontends use the bearer token.
COOKIE_SECURE=false
# Optional extra password in front of everything (HTTP Basic auth on everything except /health).
# BASIC_AUTH_USER=demo
# BASIC_AUTH_PASSWORD=

# --- Limits ----------------------------------------------------------------------------------------
RC_MAX_UPLOAD_MB=200
RC_MAX_VIDEO_SECONDS=300
RC_FRAME_SAMPLES=6
# Optional FFmpeg path; otherwise PATH, then the bundled imageio-ffmpeg.
# RC_FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
