# Reality Compiler — backend configuration.
# Copy to .env (repository root or backend/) and adjust. All variables are optional.
# Nothing here is exposed to the browser.

# Storage: database and uploaded media (default: backend/data)
# RC_DATA_DIR=./backend/data
# RC_DATABASE_URL=sqlite:///./backend/data/reality_compiler.db

# Comma-separated origins allowed to call the API (the Vite dev server proxies /api by default)
RC_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Upload limits
RC_MAX_UPLOAD_MB=200
RC_MAX_VIDEO_SECONDS=300

# Media processing. Leave empty to use ffmpeg from PATH, or the binary bundled with imageio-ffmpeg.
# RC_FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
RC_FRAME_SAMPLES=6
RC_FRAME_WIDTH=640

# Speech transcription (faster-whisper). The first run downloads the model weights.
RC_WHISPER_ENABLED=true
RC_WHISPER_MODEL=base
RC_WHISPER_DEVICE=cpu
RC_WHISPER_COMPUTE_TYPE=int8

# Ollama-compatible model server and an installed multimodal (vision) model
RC_OLLAMA_URL=http://127.0.0.1:11434
RC_OLLAMA_MODEL=gemma4:e4b
# Alternative tested model: qwen3.5:4b (faster on CPU, weaker rule mapping)
RC_OLLAMA_TIMEOUT_SECONDS=600
RC_MODEL_TEMPERATURE=0.1
